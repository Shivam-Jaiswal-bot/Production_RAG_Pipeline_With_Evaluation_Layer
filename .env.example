# ---- API keys (required for Phases 2+) ----
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
COHERE_API_KEY=replace-me

# ---- SEC EDGAR (required for Phase 2 ingestion) ----
# EDGAR mandates a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# ---- Optional model overrides (defaults match core/config.py) ----
# GENERATOR_MODEL=claude-sonnet-4-6
# JUDGE_MODEL=claude-opus-4-7
# EMBEDDING_MODEL=text-embedding-3-large
# RERANKER_MODEL=rerank-v3.0

# ---- Optional retrieval overrides ----
# RETRIEVER_TYPE=dense   # dense | sparse | hybrid | hybrid_rerank
# TOP_K=10
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
